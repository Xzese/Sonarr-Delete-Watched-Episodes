SONARR_URL=
SONARR_KEY=
MEDIA_SERVICE=plex
DAYS_TO_DELETE=2
# Per-apply caps. Set either to 0 to disable it. CLI flags override these values.
MAX_FILES=10
MAX_BYTES=10000000000
# Weekly rotation on Monday at local midnight. Retain four rotated files by default.
LOG_FILE=output/log.txt
LOG_LEVEL=INFO
LOG_RETENTION_WEEKS=4
# Required: explicitly accept which users can authorise shared-file deletion.
# Plex supports selected-user (the token's user). Jellyfin also supports all-selected.
WATCH_POLICY=selected-user
# Plex: only the Delete genre qualifies unless explicitly changed to true.
DEFAULT_DELETE=false
PLEX_URL=
PLEX_TOKEN=
PLEX_LIBRARY=TV Shows
# Jellyfin: set exactly one of these; all-selected intersects every selected user's eligibility.
JELLYFIN_URL=
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=
# Comma-separated UUIDs. Set WATCH_POLICY=all-selected when using multiple users.
JELLYFIN_USER_IDS=
